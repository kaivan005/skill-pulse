PORT=4000
# Paste the pooled Neon connection string here. Keep sslmode=require.
# Example: postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
# Docker runs the demo seed against the database selected above on startup.
SEED_DEMO_DATA=true
# Keep false until a real IVR provider is reviewed and configured.
IVR_ENABLED=false
